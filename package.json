{
  "name": "lettrage-auto-paypal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transforme un export CSV (PayPal, banque, etc.) en fichier Excel trie, categorise et pret pour le lettrage comptable.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "test": "node --import tsx --test scripts/activity.test.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
